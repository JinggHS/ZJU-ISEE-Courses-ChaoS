%-------------------------全局设置------------------------------%
\setlength{\headheight}{14.49998pt}
\addtolength{\topmargin}{-2.49998pt}
\setlength{\parindent}{2em}

\hypersetup{
    colorlinks=true,
    linkcolor=black
}

% question 问题环境
\definecolor{shadecolor}{RGB}{241, 241, 255}
\newcounter{problemname}
\newenvironment{problem}{%
    \begin{shaded}
    \stepcounter{problemname}
    \par\noindent\textbf{Question.\arabic{problemname}. }
}{%
    \end{shaded}\par
}
\newenvironment{solution}{\par\noindent\textbf{解答.}}{\par}

%-------------------------目录设置------------------------------%
\newcommand{\maketoc}{%
    \newpage
    \tableofcontents
    \thispagestyle{empty}
    \newpage
    \pagenumbering{arabic}
}

%-------------------------页眉页脚------------------------------%
\makeatletter
\newcommand{\classname}[1]{\gdef\@classname{#1}}
\newcommand{\printclassname}{\@classname}
\makeatother

\newcommand{\makepagestyle}[2]{%
    \pagestyle{fancy}
    \rhead{#1}
    \lhead{#2}
    \cfoot{Page \thepage}
}

\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\theenumi}{(\arabic{enumi})}

%-------------------------封面设置------------------------------%
\newcommand{\maketitlepage}[5]{%
    \begin{titlepage}
        \vspace{-3cm}

        \IfFileExists{figureschar.png}{%
            \begin{figure}[h]
                \centering
                \includegraphics[width=0.65\linewidth]{figureschar.png}
            \end{figure}
        }{}

        \IfFileExists{logo.png}{%
            \begin{figure}[h]
                \centering
                \includegraphics[width=0.48\linewidth]{logo.png}
            \end{figure}
        }{}

        \vspace{-0.5cm}
        \begin{center}
            \Huge{\textbf{\printclassname} \textbf{实验报告}}
        \end{center}
        \vspace{0.5cm}
        \begin{center}
            \Large
            实验名称  \underline{\makebox[220pt]{#1}}
            \vspace{0.3cm}

            \quad 姓\quad 名  \underline{\makebox[220pt]{#2}}
            \vspace{0.3cm}

            \quad 学\quad 号  \underline{\makebox[220pt]{#3}}
            \vspace{0.3cm}

            实验日期  \underline{\makebox[220pt]{#4}}
            \vspace{0.3cm}

            指导老师  \underline{\makebox[220pt]{#5}}
        \end{center}
    \end{titlepage}
}

%-------------------------代码设置------------------------------%
\lstset{
    language=Tex,
    basicstyle=\ttfamily,
    breaklines=true,
    keywordstyle=\bfseries\color{NavyBlue},
    morekeywords={},
    emph={self},
    emphstyle=\bfseries\color{Rhodamine},
    commentstyle=\color{black!50!white},
    stringstyle=\bfseries\color{PineGreen!90!black},
    columns=flexible,
    numbers=left,
    numbersep=2em,
    numberstyle=\footnotesize,
    frame=shadowbox,
    rulesepcolor=\color{red!20!green!20!blue!20},
    showstringspaces=false
}

\newcommand{\reference}{%
    \nocite{*}
    \bibliographystyle{unsrt}
    \begin{center}
        \bibliography{ref}
    \end{center}
}
